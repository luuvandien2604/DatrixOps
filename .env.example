# DatrixOps environment template.
# Copy to .env and replace every generated value before running Docker Compose.

# PostgreSQL application password. Generate a high-entropy value, for example:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT signing secret. Must be at least 32 characters and must not be a sample value.
# Generate a high-entropy value, for example:
#   openssl rand -base64 48
JWT_SECRET=

# Public browser origin and Agent callback origin. HTTPS is required outside
# localhost. Do not include a trailing slash.
PUBLIC_URL=

# Comma-separated browser origins allowed to call the API.
# Example: https://ops.example.com
ALLOWED_ORIGINS=

# Hostname used by the bundled Caddy gateway. For direct Compose access on
# port 3000 this can remain :80. For deploy/docker-compose.yml use a DNS name.
DATRIXOPS_DOMAIN=:80

# Current agent release advertised by the control plane.
# Example: 1.5.2
AGENT_VERSION=

# Optional override. Defaults to ${PUBLIC_URL}/releases.
AGENT_RELEASE_BASE_URL=

# High-risk and advanced Agent features are disabled by default.
ENABLE_PUBLIC_REGISTRATION=false
ENABLE_WEB_TERMINAL=false
ENABLE_REMOTE_SCRIPTS=false
ENABLE_SERVICE_CONTROLS=false
ENABLE_READ_ONLY_LOGS=false

# Database retention. Downsampling is planned separately; raw data is bounded.
METRICS_RETENTION_DAYS=7
OPERATIONAL_RETENTION_DAYS=90

# Frontend API path used at build time.
NEXT_PUBLIC_API_URL=/api/v1

# Default quick-start host port. The production deploy compose uses 80/443.
DATRIXOPS_HTTP_PORT=3000
