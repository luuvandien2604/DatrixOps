{
	admin off
}

http://127.0.0.1 {
	@health path /health /ready /health/live /health/ready
	reverse_proxy @health backend:8080 {
		header_up X-DatrixOps-Gateway "caddy"
	}
}

{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-DatrixOps-Gateway "caddy"
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# API and both reverse-terminal WebSocket channels go straight to Go.
	# Caddy preserves Upgrade/Connection and X-Forwarded-Host automatically.
	@health path /health /ready /health/live /health/ready
	reverse_proxy @health backend:8080 {
		header_up X-DatrixOps-Gateway "caddy"
	}

	@api path /api/v1 /api/v1/*
	reverse_proxy @api backend:8080 {
		header_up X-DatrixOps-Gateway "caddy"
	}

	# Dashboard, documentation, installers, and signed Agent releases.
	reverse_proxy frontend:3000
}
