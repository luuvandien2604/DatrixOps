# Required secrets. Run ./deploy/generate-secrets.sh to populate them.
POSTGRES_PASSWORD=
JWT_SECRET=

# Public DNS name and HTTPS origin.
DATRIXOPS_DOMAIN=monitor.example.com
PUBLIC_URL=https://monitor.example.com
ALLOWED_ORIGINS=https://monitor.example.com
DATRIXOPS_EDITION=community
DEPLOYMENT_MODE=self-hosted

# Pin the Agent release advertised by this control plane.
DATRIXOPS_VERSION=1.5.5
AGENT_VERSION=1.5.5
AGENT_RELEASE_BASE_URL=

# High-risk and advanced Agent features are disabled by default.
ENABLE_PUBLIC_REGISTRATION=false
ENABLE_WEB_TERMINAL=false
ENABLE_REMOTE_SCRIPTS=false
ENABLE_SERVICE_CONTROLS=false
ENABLE_READ_ONLY_LOGS=false
METRICS_RETENTION_DAYS=7
OPERATIONAL_RETENTION_DAYS=90

NEXT_PUBLIC_API_URL=/api/v1
DATRIXOPS_HTTP_PORT=80
DATRIXOPS_HTTPS_PORT=443
